{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness-benchmark-metric",
  "description": "One record per (harness, phase, trial). Fill the null fields from the harness's own usage log; compute cost_usd yourself from token counts x the GPT-5.5 price sheet so both harnesses are comparable.",
  "type": "object",
  "required": ["harness", "phase", "trial", "model", "wall_clock_s"],
  "properties": {
    "harness": { "enum": ["codex", "pi"] },
    "phase": { "enum": ["plan", "result"] },
    "trial": { "type": "integer", "minimum": 1 },
    "model": { "type": "string" },
    "branch": { "type": "string" },
    "base_sha": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "wall_clock_s": { "type": "number" },
    "input_tokens": { "type": ["integer", "null"] },
    "cached_input_tokens": { "type": ["integer", "null"] },
    "output_tokens": { "type": ["integer", "null"] },
    "reasoning_tokens": { "type": ["integer", "null"] },
    "tool_calls": { "type": ["integer", "null"] },
    "time_to_first_edit_s": { "type": ["number", "null"] },
    "cost_usd": { "type": ["number", "null"] }
  }
}
